{
  "format": "liminal-dialogue/2",
  "id": "syochou",
  "name": "所長",
  "images": {
    "base": "assets/images/syochou/",
    "idle": "idle",
    "faces": { "normal": "normal.png", "normal2": "normal2.png", "smile": "smile.png", "idle": "idle.png" },
    "notes": { "normal": "口開き", "normal2": "目逸らし", "smile": "目開き笑顔", "idle": "口閉じ" }
  },
  "rules": {
    "storyEvery": 5,
    "stages": [
      { "id": "early", "label": "序盤", "until": 10 },
      { "id": "normal", "label": "中盤", "until": 30 },
      { "id": "late", "label": "終盤" }
    ]
  },
  "vars": {},
  "topics": [
    {
      "id": "main1",
      "pools": ["story"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "私は不老不死なんだ。" },
            { "text": "私の死んだ体が別であって、私が死ぬとあっちの体が生きていたことになる" },
            { "text": "どうあれ、最後には独りだ。" },
            { "text": "……" },
            { "face": "normal2", "text": "つまらない話だったね" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "main2",
      "pools": ["story"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "わたしの研究所に住み着いている女子高生、でんでんというのだけど" },
            { "face": "normal", "text": "諸事情でここに置いている。ろくなことをしないけど、ペットが増えたみたいだ。" },
            { "text": "退屈凌ぎには誰かいたほうがいいし、気がまぎれるが本当にうるさい。" },
            { "face": "normal2", "text": "やれスーパーに行くだのモールに連れてけだの。ホント厄介だよ　はぁ……" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "main3",
      "pools": ["story"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "元々ここには別の所長がいたんだ。職員が何人かいたし、そこでは研究が行われてた" },
            { "text": "時空について調べていたんだ。" },
            { "text": "頭の切れるいい人だった。妙に達観していて" },
            { "text": "もう誰も信じないことにしている。裏切られるなら裏切る側を選ぶ。" },
            { "face": "normal2", "text": "君も酷い目に遭わないといいね。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "f1",
      "pools": ["first"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "初めまして。私はこの研究所の所長。" },
            { "face": "smile", "text": "話し相手なら喜んでなろう。退屈しているんだ、長生きなのでね。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e1",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "久々に面白い小説を見つけた、話が終わるのが怖くてまだ読み終えていないけど。" },
            { "text": "何かを消費してしまうのって怖くないか？" }
          ],
          "next": {
            "type": "choice",
            "options": [{ "label": "わからない", "goto": "a" }, { "label": "わかる気がする", "goto": "b" }]
          }
        },
        {
          "id": "a",
          "lines": [
            { "face": "normal", "text": "良質なもの、まして自分の好みなものはあまり多くない。" },
            { "text": "それを一つ減らしてしまうのは満足感も喪失感も感じる。" },
            { "face": "normal2", "text": "それが楽しむってことなのはわかっているけど……" }
          ],
          "next": { "type": "end" }
        },
        {
          "id": "b",
          "lines": [
            { "face": "smile", "text": "わかってくれるかい。" },
            { "face": "normal2", "text": "君は遊園地とか、綺麗な景色を見た時に「もうこれ以上楽しいことはないかも」と" },
            { "text": "絶望するタイプかもね。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e2",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "塩分の濃いものが好きなんだよな、米と同量の塩をかけて食べることがある" },
            { "text": "多分君の思っている体の構造をしていないんだ、私は" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e3",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "トーラスとドーナツって響きも形状も似ているよな。" },
            { "text": "……" },
            { "text": "それだけだけど？" },
            { "face": "normal2", "text": "一方的に何か話すのって大変なんだぞ" }
          ],
          "next": {
            "type": "choice",
            "options": [{ "label": "何か話す", "goto": "a" }, { "label": "話さない", "goto": "b" }]
          }
        },
        {
          "id": "a",
          "lines": [
            { "face": "normal", "text": "じゃあ話してみてよ" },
            { "text": "……" },
            { "text": "……" },
            { "text": "な、分かっている。話せるわけないんだよ。" },
            { "text": "そう作られていないんだ、君が返せるのは決められた選択肢だけ" },
            { "text": "退屈だ、ほかのコマンドとか持ってないの？" }
          ],
          "next": { "type": "end" }
        },
        {
          "id": "b",
          "lines": [
            { "face": "normal", "text": "……" },
            { "text": "せいぜい君が退屈しないように楽しませないとな" },
            { "text": "立ち去らないように" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e4",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "何年も生きていて、自分の気がつかなかった好きなものとか" },
            { "text": "嫌いなものに気がつくことって結構あるね。" },
            { "text": "例えばホラーは好きだけどグロテスクなものは嫌いとか" },
            { "text": "カニが可愛いから好きとか" },
            { "text": "自分のことさえ知り尽くすのには何年も時間がかかるよ" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e5",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "夢は見る方？私はよく見る方だ。" },
            { "text": "存在しない、昔からの大切な友人がいたり、偽物の家族がいたり" },
            { "text": "知らない場所を彷徨ったり、恐ろしいけど安心する" },
            { "text": "ずっと目覚めなきゃ良いのにね。どうせ起きたらこんな……" },
            { "text": "……" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e6",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "幽霊を見たことある？" },
            { "text": "この町では少なくとも何人かの幽霊を見たことがあるよ。だいたい子供から青年くらいまでで" },
            { "text": "みんな輪っかがついてるんだ。" },
            { "text": "あれが幽霊なのかわからないけど、成仏はできてなさそうだよな" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e7",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "冬も夏も嫌いだ。寒いし暑いし乾燥も湿潤も最悪だからな" },
            { "text": "秋も嫌い。何か死んでいく季節だというイメージがある。" },
            { "text": "とはいえ春は花粉まみれで気持ち悪い。" },
            { "text": "嫌いなものばかりに目を向けてはダメだとわかっているが" },
            { "text": "嫌いなものから好きな物を見つけるのはなかなか難しいよ。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e8",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "アルコールってあんまり飲まないんだけど、アレ美味しいか……？" },
            { "text": "ぶどうジュースの濃いやつだと思ってワインを飲んだら全然苦いし" },
            { "text": "ビールもレモンサワーも苦い、ついでに頭も痛くなる。" },
            { "text": "少しふわふわっと気分が良くなるけど、酒は若干苦手だな。主に味がダメだ。" },
            { "text": "楽しそうに酒を交わす人を見ると少し羨ましく思うよ。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e9",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "不死身だからさ、目覚まし時計をかけ損ねると１０日くらい寝ちゃうんだ。" },
            { "text": "……" },
            { "text": "ほんとは一年くらい寝てた。" },
            { "text": "起きる理由がなければそうなるよね。そうなるよ。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "e10",
      "pools": ["early"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "不老不死って死ぬのが怖くなさそうに見えるでしょ。" },
            { "text": "実はそうでもないよ。なれるけど本能的に死を恐れる様になっている。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "n1",
      "pools": ["normal"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "人間は何かを自分の代わりにさせるのが好きみたいだね。" },
            { "text": "自分の仕事を別のものにさせて、他にやりたいことが思いつく人はどれだけいるのだろう。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "n2",
      "pools": ["normal"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "でんでんがよく猫の動画を見てる。" },
            { "text": "ふわふわじゃなくて、ぱやぱやのおけけなんだよ〜って見せてくるんだよ。" },
            { "text": "小さい生き物って力加減がわからなくて苦手なんだけど、ちょっと触ってみたくなった。猫ちゃんいないかな" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
    {
      "id": "n3",
      "pools": ["normal"],
      "scenes": [
        {
          "id": "start",
          "lines": [
            { "face": "normal", "text": "でんでんが勉強を教えるようにせがんでくる、化学とか国語とか" },
            { "text": "化学は基本暗記というか、教科書読めばわかるし、国語は私がわからない。" },
            { "text": "だから教科書を開いて勉強しなさいというと怒るんだよ、どうすればいい……" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
