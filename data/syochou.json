          "id": "start",
          "lines": [
            { "face": "normal", "text": "人間は何かを自分の代わりにさせるのが好きみたいだね。" },
            { "text": "自分の仕事を別のものにさせて、他にやりたいことが思いつく人はどれだけいるのだろう。" }
          ],
          "next": { "type": "end" }
        }
      ]
    },
