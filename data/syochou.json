          "id": "start",
          "lines": [
            { "face": "normal", "text": "でんでんがよく猫の動画を見てる。" },
            { "text": "ふわふわじゃなくて、ぱやぱやのおけけなんだよ〜って見せてくるんだよ。" },
            { "text": "小さい生き物って力加減がわからなくて苦手なんだけど、ちょっと触ってみたくなった。猫ちゃんいないかな" }
          ],
          "next": { "type": "end" }
        }
      ]
